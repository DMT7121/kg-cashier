{
  "routes": [
    {
      "routePath": "/cukcuk-api/:path*",
      "mountPath": "/cukcuk-api",
      "method": "DELETE",
      "module": [
        "cukcuk-api/[[path]].js:onRequestDelete"
      ]
    },
    {
      "routePath": "/cukcuk-api/:path*",
      "mountPath": "/cukcuk-api",
      "method": "GET",
      "module": [
        "cukcuk-api/[[path]].js:onRequestGet"
      ]
    },
    {
      "routePath": "/cukcuk-api/:path*",
      "mountPath": "/cukcuk-api",
      "method": "OPTIONS",
      "module": [
        "cukcuk-api/[[path]].js:onRequestOptions"
      ]
    },
    {
      "routePath": "/cukcuk-api/:path*",
      "mountPath": "/cukcuk-api",
      "method": "POST",
      "module": [
        "cukcuk-api/[[path]].js:onRequestPost"
      ]
    },
    {
      "routePath": "/cukcuk-api/:path*",
      "mountPath": "/cukcuk-api",
      "method": "PUT",
      "module": [
        "cukcuk-api/[[path]].js:onRequestPut"
      ]
    }
  ],
  "baseURL": "/"
}